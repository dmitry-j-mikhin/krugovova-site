# Скопировать в .beget.env и заполнить из письма Beget.
# Файл с паролем в git не попадает (см. .gitignore).
FTP_HOST=xxxxxxx.beget.tech
FTP_USER=xxxxxxx
FTP_PASS=пароль-от-ftp
# Каталог сайта на хостинге. Обычно так, где login — ваш логин,
# а домен — технический адрес сайта из панели:
FTP_DIR=/login.bget.ru/public_html
